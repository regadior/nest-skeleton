APP_PORT=4000
APP_NAME=nestjs-skeleton
VERSION=0.01

## Docker config ##
IMAGE_NAME=nestjs-skeleton
IMAGE_NAME_DB=nestjs-skeleton-postgres
EXTERNAL_PORT=5434

#DB config ##
DB_HOST=localhost
DB_TYPE=postgresql
DB_PORT=5432
