DB_USER=user
DB_PASSWORD=password
DATABASE_URL=${DB_TYPE}://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

#CORS
FRONTEND_URL=

JWT_EXPIRES_IN=24h

